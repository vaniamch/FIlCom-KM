{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access control",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["admin", "editor", "member"] },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "department": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "displayName", "role", "status"]
    },
    "KnowledgeArticle": {
      "title": "KnowledgeArticle",
      "description": "Institutional knowledge article and SOP guides",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 3, "maxLength": 256 },
        "content": { "type": "string", "minLength": 10, "maxLength": 50000 },
        "summary": { "type": "string", "maxLength": 500 },
        "categoryId": { "type": "string", "maxLength": 128 },
        "categoryName": { "type": "string", "maxLength": 128 },
        "department": { "type": "string", "maxLength": 128 },
        "knowledgeType": { "type": "string", "maxLength": 64 },
        "tags": { "type": "array", "description": "Tags list" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 128 },
        "authorEmail": { "type": "string", "maxLength": 256 },
        "status": { "type": "string", "enum": ["published", "draft", "archived", "pending_review", "in_review", "approved", "rejected"] },
        "viewsCount": { "type": "number" },
        "bookmarkCount": { "type": "number" },
        "attachments": { "type": "array", "description": "Attached file references" },
        "isSOP": { "type": "boolean" },
        "sopNumber": { "type": "string", "maxLength": 64 },
        "purpose": { "type": "string", "maxLength": 5000 },
        "scope": { "type": "string", "maxLength": 5000 },
        "responsibilities": { "type": "string", "maxLength": 5000 },
        "references": { "type": "string", "maxLength": 5000 },
        "reviewer": { "type": "string", "maxLength": 128 },
        "approver": { "type": "string", "maxLength": 128 },
        "approvedBy": { "type": "string", "maxLength": 128 },
        "approvedAt": { "type": "string", "format": "date-time" },
        "rejectedReason": { "type": "string", "maxLength": 1000 },
        "effectiveDate": { "type": "string", "maxLength": 64 },
        "reviewDate": { "type": "string", "maxLength": 64 },
        "revisionNumber": { "type": "string", "maxLength": 32 },
        "revisionHistory": { "type": "array", "description": "Historical revisions of the article or SOP" },
        "sopSteps": { "type": "array", "description": "Ordered SOP steps with PIC and notes" },
        "targetCommittee": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "content", "categoryId", "authorId", "status"]
    },
    "Category": {
      "title": "Category",
      "description": "Classification topic for knowledge and documents",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 2, "maxLength": 128 },
        "description": { "type": "string", "maxLength": 500 },
        "icon": { "type": "string", "maxLength": 64 },
        "slug": { "type": "string", "maxLength": 128 },
        "articleCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "slug"]
    },
    "DocumentItem": {
      "title": "DocumentItem",
      "description": "Repository file item with metadata and storage reference",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 2, "maxLength": 256 },
        "description": { "type": "string", "maxLength": 1000 },
        "categoryId": { "type": "string", "maxLength": 128 },
        "categoryName": { "type": "string", "maxLength": 128 },
        "fileUrl": { "type": "string", "maxLength": 4096 },
        "fileName": { "type": "string", "maxLength": 256 },
        "fileSize": { "type": "number" },
        "fileType": { "type": "string", "maxLength": 64 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 128 },
        "downloadsCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "fileUrl", "fileName", "authorId"]
    },
    "CampusEvent": {
      "title": "CampusEvent",
      "description": "Historical event record with documentation and evaluation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 3, "maxLength": 256 },
        "description": { "type": "string", "maxLength": 5000 },
        "date": { "type": "string", "maxLength": 64 },
        "academicYear": { "type": "string", "maxLength": 32 },
        "committee": { "type": "string", "maxLength": 128 },
        "outcomes": { "type": "string", "maxLength": 5000 },
        "documentationUrl": { "type": "string", "maxLength": 2048 },
        "reports": { "type": "array", "description": "Report links" },
        "evaluation": { "type": "string", "maxLength": 5000 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "date", "committee", "authorId"]
    },
    "LessonLearned": {
      "title": "LessonLearned",
      "description": "Key takeaways, challenges, solutions and recommendations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "activityTitle": { "type": "string", "minLength": 3, "maxLength": 256 },
        "categoryId": { "type": "string", "maxLength": 128 },
        "categoryName": { "type": "string", "maxLength": 128 },
        "challenges": { "type": "string", "maxLength": 5000 },
        "solutions": { "type": "string", "maxLength": 5000 },
        "recommendations": { "type": "string", "maxLength": 5000 },
        "impactLevel": { "type": "string", "enum": ["low", "medium", "high"] },
        "createdBy": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "activityTitle", "challenges", "solutions", "recommendations", "impactLevel", "authorId"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "Saved articles or documents for a specific user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "targetId": { "type": "string", "maxLength": 128 },
        "targetType": { "type": "string", "enum": ["knowledge", "document", "sop", "lesson"] },
        "title": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "targetId", "targetType", "title"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "System audit trail and activity log",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 256 },
        "action": { "type": "string", "maxLength": 128 },
        "entityType": { "type": "string", "maxLength": 64 },
        "entityId": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "action", "entityType"]
    },
    "FileChunk": {
      "title": "FileChunk",
      "description": "Chunked file payload segments for reliable document persistence",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "groupId": { "type": "string", "maxLength": 128 },
        "index": { "type": "number" },
        "data": { "type": "string", "maxLength": 600000 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "groupId", "index", "data", "createdBy"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile with role-based access"
    },
    "/admins/{userId}": {
      "schema": "User",
      "description": "Authorized administrators collection for fast exists() security rule checks"
    },
    "/knowledge/{articleId}": {
      "schema": "KnowledgeArticle",
      "description": "Knowledge repository articles and SOP guides"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Taxonomy categories for knowledge and files"
    },
    "/documents/{documentId}": {
      "schema": "DocumentItem",
      "description": "Uploaded institutional documents and spreadsheets"
    },
    "/events/{eventId}": {
      "schema": "CampusEvent",
      "description": "Event archive records and evaluations"
    },
    "/lessons_learned/{lessonId}": {
      "schema": "LessonLearned",
      "description": "Post-mortem challenges, solutions and recommendations"
    },
    "/bookmarks/{bookmarkId}": {
      "schema": "Bookmark",
      "description": "Personal bookmarks saved by members"
    },
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Auditing and activity stream records"
    },
    "/file_chunks/{chunkId}": {
      "schema": "FileChunk",
      "description": "Segmented binary data chunks for uploaded files"
    }
  }
}
